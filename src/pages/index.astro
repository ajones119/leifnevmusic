---
import { site, validateSite, upcomingShows } from '../data/site';
import '../styles/site.css';

const production = import.meta.env.SITE_RELEASE === 'production';
const errors = validateSite(site, { production });
if (errors.length) throw new Error(errors.join('\n'));
const shows = upcomingShows(site);

const origin = site.siteUrl.replace(/\/$/, '');
const canonical = origin ? origin + '/' : undefined;
const sharingImage = origin ? new URL(site.socialImage.src, origin).href : undefined;
const identity = {
  '@context': 'https://schema.org', '@type': 'MusicGroup',
  ...(origin ? { '@id': origin + '/#artist', url: canonical } : {}),
  name: site.artist.name, description: site.artist.description,
  ...(sharingImage ? { image: sharingImage } : {}),
  location: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: site.artist.location.city, addressRegion: site.artist.location.region, addressCountry: site.artist.location.country } },
  sameAs: Object.values(site.socials).filter(Boolean),
};
const identityJson = JSON.stringify(identity).replace(/</g, '\\u003c');

const socialLinks = [
  { name: 'Instagram', icon: 'instagram', url: site.socials.instagram },
  { name: 'Facebook', icon: 'facebook', url: site.socials.facebook },
  { name: 'Spotify', icon: 'spotify', url: site.socials.spotify },
].filter(link => link.url || !production);
const tipLinks = [
  { name: 'Cash App', icon: 'cash-app', url: site.tips.cashApp },
  { name: 'Venmo', icon: 'venmo', url: site.tips.venmo },
].filter(link => link.url || !production);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={production ? "index, follow" : "noindex, nofollow"} />
    <meta name="description" content={site.seoDescription} />
    <title>{site.seoTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.seoTitle} />
    <meta property="og:description" content={site.seoDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {sharingImage && <><meta property="og:image" content={sharingImage} /><meta property="og:image:alt" content={site.socialImage.alt} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:card" content={sharingImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={site.seoTitle} />
    <meta name="twitter:description" content={site.seoDescription} />
    {sharingImage && <><meta name="twitter:image" content={sharingImage} /><meta name="twitter:image:alt" content={site.socialImage.alt} /></>}
    <script type="application/ld+json" set:html={identityJson} />
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/DMSans-Latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#shows-title">Skip to upcoming shows</a>
    <svg class="icons" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="cash-app" viewBox="0 0 24 24"><rect x="1" y="1" width="22" height="22" rx="6" fill="currentColor"/><path d="m14.1 5.2-.5 2.1m-3.2 9.4-.5 2.1m5-9.7c-1.8-1.6-5.8-1.4-6.1.8-.4 2.3 6.6 1.2 6.2 4.5-.3 2.7-4.8 3.7-7.7 1.4" fill="none" stroke="var(--page-bg)" stroke-width="2" stroke-linecap="round"/></symbol>
      <symbol id="venmo" viewBox="0 0 24 24"><path fill="currentColor" d="M20.8 2.4c.8 1.3 1.2 2.7 1.2 4.4 0 5.4-4.6 12.4-8.3 16H5.1L1.8 3.4l7.5-.7L11 16.5c1.5-2.2 3.3-5.8 3.3-8.3 0-1.5-.3-2.6-.8-3.7z"/></symbol>
      <symbol id="instagram" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.6" cy="6.7" r="1.2" fill="currentColor"/></symbol>
      <symbol id="facebook" viewBox="0 0 24 24"><path fill="currentColor" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7v-3.6h3.1V9.2c0-3.1 1.8-4.8 4.6-4.8 1.4 0 2.8.2 2.8.2v3.1h-1.6c-1.5 0-1.9.9-1.9 1.9v2.3h3.3l-.5 3.6H14v8.4A12 12 0 0 0 24 12z"/></symbol>
      <symbol id="spotify" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M6.1 8.8c4.1-1.2 8.4-.9 12 1.2M6.8 12c3.5-1 7.1-.7 10.2 1M7.6 15c2.8-.7 5.7-.5 8.2.9" fill="none" stroke="var(--page-bg)" stroke-width="1.6" stroke-linecap="round"/></symbol>
    </svg>
    <main class="page-column">
      <header class="hero" aria-labelledby="artist-name">
        <div class="portrait-composition">
          <div class="depth-frame" data-depth-frame data-depth-mode={site.media.heroMotion ?? 'baseline'}>
            <div class="depth-art" role="img" aria-label={site.media.heroAlt}>
              <div class="depth-drift" data-depth-float>
              <div class="depth-crop">
                <div class="depth-canvas bridge-plane"><img src={site.media.heroBackground} srcset={site.media.heroBackgroundSrcSet} sizes="(max-width: 800px) 100vw, 800px" alt="" width="1024" height="1536" fetchpriority="high" /></div>
                <div class="depth-canvas musician-plane" data-depth-subject><img src={site.media.heroMusician} srcset={site.media.heroMusicianSrcSet} sizes="(max-width: 800px) 88vw, 704px" alt="" width="1024" height="1536" /></div>
              </div>
              </div>
            </div>
          </div>
          <h1 id="artist-name" class="sr-only">{site.artist.name}</h1>
        </div>
        {(socialLinks.length > 0 || tipLinks.length > 0) && <nav class="actions" aria-label="Follow and support Leif">
          {socialLinks.length > 0 && <div class="social-row">{socialLinks.map(link => <a class="social" href={link.url || '/'} aria-label={link.name}><svg aria-hidden="true"><use href={`#${link.icon}`} /></svg><span>{link.name}</span></a>)}</div>}
          {tipLinks.length > 0 && <div class="tip-row">{tipLinks.map(link => <a class="tip" href={link.url || '/'} aria-label={link.name}><svg aria-hidden="true"><use href={`#${link.icon}`} /></svg><span>{link.name}</span></a>)}</div>}
        </nav>}
      </header>
      <section class="shows" aria-labelledby="shows-title">
        <div class="section-heading"><h2 id="shows-title" tabindex="-1">Upcoming shows</h2></div>
        {shows.length ? <table>
          <caption class="sr-only">{shows.some(show => show.sample) ? 'Preview performances include sample rows for layout review. Sample events are not confirmed.' : `Upcoming performances. All times are in ${site.timezone}.`}</caption>
          <colgroup><col class="date-column"/><col/><col class="time-column"/></colgroup>
          <thead><tr><th scope="col">Date</th><th scope="col">Place</th><th scope="col">Time</th></tr></thead>
          <tbody>{shows.map(show => <tr data-sample={show.sample || undefined}>
            <td><time datetime={show.startsAt}><span class="date-month">{show.month}</span><span class="date-day">{show.day}</span></time></td>
            <td>{show.sample && <span class="sr-only">Sample performance: </span>}{show.venue.url ? <a class="venue-link" href={show.venue.url}>{show.venue.name}</a> : show.venue.name}<span class="venue-location">{[show.venue.city, show.venue.region].filter(Boolean).join(', ')}</span></td>
            <td>{show.time}</td>
          </tr>)}</tbody>
        </table> : <p>More shows soon.{site.socials.instagram && <> Follow along on <a href={site.socials.instagram}>Instagram</a>.</>}</p>}
      </section>
      <section class="about" aria-labelledby="about-title">
        {site.artist.portrait.src ? <figure class="portrait-print"><img class="artist-portrait" src={site.artist.portrait.src} alt={site.artist.portrait.alt} width={site.artist.portrait.width} height={site.artist.portrait.height} loading="lazy" decoding="async" /></figure> : <div class="portrait-placeholder" role="img" aria-label="Placeholder for the artist's final portrait"><span class="placeholder-cross" aria-hidden="true">+</span><span>Room for a portrait</span><span class="placeholder-detail">Final photograph to come</span></div>}
        <div class="bio"><h2 id="about-title">A little about Leif</h2>{site.artist.bio.paragraphs.map(paragraph => <p>{paragraph}</p>)}{site.artist.bio.placeholder && <p class="proof-note">Biography placeholder · final words to come</p>}</div>
      </section>
      <footer class="footer">
        <div class="footer-accent-container" data-footer-container aria-hidden="true">
          <img class="footer-accent footer-accent-still" data-footer-still src={site.media.footerStill} alt="" width="640" height="640" loading="lazy" decoding="async" />
          <video class="footer-accent footer-accent-video" data-footer-video data-src={site.media.footerVideo} preload="none" muted playsinline width="320" height="320"></video>
        </div>
        <p class="quote">{site.footer.quote}</p>
        {site.footer.attribution && <p class="attribution">{site.footer.attribution}</p>}
        <p class="footer-location">{site.artist.name} <span aria-hidden="true">·</span> {site.artist.location.city}</p>
      </footer>
    </main>
    <div class="footer-wheat" aria-hidden="true"></div>
    <script>
      import '../scripts/media-motion';
    </script>
  </body>
</html>
