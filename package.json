{
  "name": "leif-nevener-music",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "proof": "node proof/server.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate-site.ts && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "validate:production": "node scripts/validate-site.ts --production",
    "build:production": "npm run validate:production && astro build"
  },
  "dependencies": { "astro": "7.4.4" }
}
